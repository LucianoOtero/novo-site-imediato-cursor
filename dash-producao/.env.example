# Sessão do login humano (Espo user/password → cookie HMAC) — obrigatório ≥16 chars
SESSION_SECRET=change-me-long-random-local-dev

# Cloudflare Access (produção): exige o JWT do Access em toda requisição. Vazio = checagem desligada.
# CF_ACCESS_TEAM_DOMAIN=<equipe>.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) Tag>

# Opcional: forçar prefer=dev|prod no bloco do JSON Espo
ESPO_PREFER=prod

# Credenciais Espo/DB: preferência automática em Windows
#   C:\AggerRpa\config\espo-dash-api.json
#   C:\AggerRpa\config\database.url
# Ou override explícito:
# ESPO_DASH_API_CONFIG_PATH=
# DATABASE_URL_FILE=
# ESPO_BASE_URL=https://flyingdonkeys.com.br
# ESPO_API_KEY=
# DATABASE_URL=
# ESPO_DASH_API_CONFIG=
